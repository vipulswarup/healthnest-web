# Example GitHub Actions workflow for CI/CD
# Note: Vercel/Netlify/Cloudflare Pages handle CI/CD automatically
# This is only needed if you want custom CI/CD workflows

name: CI/CD Pipeline

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]

jobs:
  test:
    runs-on: ubuntu-latest
    
    steps:
      - uses: actions/checkout@v3
      
      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '20'
          cache: 'npm'
      
      - name: Install dependencies
        run: npm ci
      
      - name: Run linter
        run: npm run lint
      
      - name: Build application
        run: npm run build
        env:
          # Use dummy values for build - actual values set in deployment platform
          MONGODB_URI: ${{ secrets.MONGODB_URI }}
          MONGODB_DB_NAME: healthnest
          NEXTAUTH_URL: https://example.com
          NEXTAUTH_SECRET: dummy-secret-for-build
          R2_ACCOUNT_ID: dummy
          R2_ACCESS_KEY_ID: dummy
          R2_SECRET_ACCESS_KEY: dummy
          R2_BUCKET_NAME: dummy

  # Deployment is handled automatically by Vercel/Netlify/Cloudflare Pages
  # No need for manual deployment steps

